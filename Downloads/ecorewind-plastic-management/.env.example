# EcoRewind Front End Environment
VITE_API_BASE_URL=/api
VITE_API_MODE=live

# Server Environment Variables (copy to .env at project root)
# These are read by server/config.js on startup

# Server
PORT=3000
NODE_ENV=development
DB_PATH=./database/ecorewind.db
SESSION_TTL_DAYS=7

# JWT secret for signing user authentication cookies/tokens.
# REQUIRED in production; the dev fallback is insecure.
JWT_SECRET=a-very-secret-key-must-change-in-production

# Kiosk API key (plain text in dev; also stored as a bcrypt hash in the DB)
KIOSK_API_KEY=rvm-key-2024

# Comma-separated admin phone numbers
ADMIN_PHONES=9811122233

# Reward lifecycle
TOKEN_TTL_MINUTES=5
MIN_WITHDRAWAL_PAISE=100

# Public URLs / CORS
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Python/Keras inference service (Node never trusts it for money)
ML_URL=http://127.0.0.1:8100
ML_PORT=8100
ML_TIMEOUT_MS=15000
ML_THRESHOLD=0.75
# Optional: set to allow the legacy Python wallet/admin routes (internal use only)
ML_INTERNAL_KEY=
